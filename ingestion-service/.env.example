# Copy this file to .env and fill in the values.
# These point to the infrastructure running in Docker (see docker-compose.yml).
#
# Optional: Healthchecks.io ping URL for the poller's dead-man's switch
# (src/utils/healthcheck.ts). Empty disables the heartbeat.
HEALTHCHECKS_PING_URL=

KAFKA_BROKER=localhost:9092
MONGO_URI=mongodb://localhost:27017/gtfs_realtime