{
  "name": "ingestion-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "build:frontend": "tsc --noEmit -p tsconfig.frontend.json && esbuild frontend/map.ts --bundle --format=esm --outfile=src/public/dist/map.js --sourcemap",
    "dev:frontend": "esbuild frontend/map.ts --bundle --format=esm --outfile=src/public/dist/map.js --sourcemap --watch",
    "start": "node --env-file=.env dist/index.js",
    "generate:types": "mkdir -p src/generated && pbjs -t static-module -w es6 -o src/generated/gtfs-realtime.js src/proto/gtfs-realtime.proto && pbts -o src/generated/gtfs-realtime.d.ts src/generated/gtfs-realtime.js",
    "generate:containers": "cd .. && docker compose up -d",
    "pretest": "npm run build:frontend",
    "test": "vitest run --exclude tests/integration",
    "test:integration": "vitest run tests/integration",
    "start:api": "npm run build:frontend && tsx --env-file=.env src/api/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "adm-zip": "^0.6.1",
    "chart.js": "^4.4.7",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "papaparse": "^5.7.0",
    "pino-pretty": "^13.1.3",
    "protobufjs-cli": "^2.6.1",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.6.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "protobufjs": "^8.7.1"
  }
}
