# ── Infrastructure ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Docker Compose reads .env automatically from the project root.
# These values are for local development and the Hetzner server.
# Never commit .env — it's gitignored.

# PostgreSQL
POSTGRES_USER=gtfs
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gtfs_realtime

# MongoDB (currently no auth — leave as-is unless you enable auth)
MONGO_URI=mongodb://mongodb:27017/gtfs_realtime
MONGO_DATABASE=gtfs_realtime

# Kafka
KAFKA_BROKER=kafka:29092