# Copy this file to .env and fill in the values.
# These point to the infrastructure running in Docker (see docker-compose.yml).
#
# Optional: Healthchecks.io check URL for the data-quality alerts
# (src/alerting.py). Empty disables the notifier.
HEALTHCHECKS_DATA_URL=

KAFKA_BROKERS=localhost:9092
MONGO_URI=mongodb://localhost:27017/gtfs_realtime